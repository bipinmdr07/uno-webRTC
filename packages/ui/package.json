{
  "name": "@uno/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pixi": {
      "types": "./dist/pixiScene.d.ts",
      "import": "./dist/pixiScene.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@uno/shared-types": "workspace:*",
    "@uno/game-engine": "workspace:*",
    "@vueuse/core": "^12.0.0",
    "gsap": "^3.12.5",
    "pixi.js": "^8.6.6",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "vitest": "^2.1.8",
    "typescript": "~5.6.3"
  }
}
