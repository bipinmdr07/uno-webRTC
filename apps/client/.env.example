# --- Client (apps/client) public env ---
#
# Cloudflare / tunnel: disable Rocket Loader + Web Analytics / Browser Insights on the zone if you
# see broken module loads or cloudflareinsights beacon errors; deploy `pnpm --filter @uno/client build`
# (or the client Docker image), not `nuxt dev`, behind the tunnel — Vite dev assets are fragile through the edge.
#
# API: must be a URL the *browser* can call (your tunneled Fastify / API origin), not localhost unless
# everyone is on this machine.
NUXT_PUBLIC_API_BASE=http://localhost:4100

# Fastify + Socket.IO — must be an https (or http on LAN) URL the *browser* can reach for WebSocket/polling.
# On Cloudflare Tunnel: add a second HTTP public hostname to http://127.0.0.1:4100 (not a raw TCP app); set
# this to that origin, e.g. NUXT_PUBLIC_SIGNALING_URL=https://signal.yourdomain.com
NUXT_PUBLIC_SIGNALING_URL=http://localhost:4100

# Optional: `polling` alone avoids the WebSocket upgrade (helps if CF / tunnel returns errors on WSS).
# NUXT_PUBLIC_SIGNALING_TRANSPORTS=polling

VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
