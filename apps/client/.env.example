NUXT_PUBLIC_API_BASE=http://localhost:4100
# Fastify + Socket.IO (must be an https URL the *browser* can reach). For Cloudflare Tunnel:
# use a second *HTTP* public hostname to http://127.0.0.1:4100 — TCP published apps are not
# usable from the page for Socket.IO. Example: NUXT_PUBLIC_SIGNALING_URL=https://api.yourdomain.com
NUXT_PUBLIC_SIGNALING_URL=http://localhost:4100
# Optional: `polling` only avoids the WebSocket upgrade (helps if the edge shows errors around WSS).
# NUXT_PUBLIC_SIGNALING_TRANSPORTS=polling
VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
